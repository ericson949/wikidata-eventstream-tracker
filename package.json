{
  "name": "politili-afrique",
  "version": "2.0.0",
  "description": "Politili Afrique - Annuaire & Baromètre des Dirigeants d'Afrique de l'Ouest et Centrale",
  "type": "module",
  "scripts": {
    "start": "node --watch dev-server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vercel-dev": "vercel dev --listen 3005",
    "collect:countries": "node scripts/collect-countries.mjs",
    "collect:ids": "node scripts/collect-ids.mjs",
    "collect:commons": "node scripts/collect-commons.mjs",
    "pipeline:enrich": "node scripts/enrich-pipeline.mjs",
    "enrich": "node scripts/enrich-pipeline.mjs",
    "pipeline:all": "node scripts/collect-countries.mjs && node scripts/collect-ids.mjs && node scripts/collect-commons.mjs && node scripts/enrich-pipeline.mjs",
    "cron": "node scripts/cron-scheduler.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vercel": "^58.9.0",
    "vite": "^6.1.0"
  }
}
