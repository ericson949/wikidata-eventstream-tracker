{
  "rewrites": [
    {
      "source": "/api/admin/politicians/:id/vote-settings",
      "destination": "/api/tracked?id=:id"
    },
    {
      "source": "/api/tracked/:id",
      "destination": "/api/tracked?id=:id"
    },
    {
      "source": "/api/questions/:id",
      "destination": "/api/questions?id=:id"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}