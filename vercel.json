{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/admin/login",
      "dest": "/api/admin/login.js"
    },
    {
      "src": "/api/admin/check",
      "dest": "/api/admin/check.js"
    },
    {
      "src": "/api/countries",
      "dest": "/api/countries.js"
    },
    {
      "src": "/api/admin/politicians/(.*)/vote-settings",
      "dest": "/api/tracked.js?id=$1"
    },
    {
      "src": "/api/tracked/(.*)",
      "dest": "/api/tracked.js?id=$1"
    },
    {
      "src": "/api/tracked",
      "dest": "/api/tracked.js"
    },
    {
      "src": "/api/politicians",
      "dest": "/api/politicians.js"
    },
    {
      "src": "/api/questions/(.*)",
      "dest": "/api/questions.js?id=$1"
    },
    {
      "src": "/api/questions",
      "dest": "/api/questions.js"
    },
    {
      "src": "/api/votes",
      "dest": "/api/votes.js"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.js"
    },
    {
      "src": "/api/vote",
      "dest": "/api/vote.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
